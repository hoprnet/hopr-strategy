.claude/

# Generated by Cargo
# will have compiled files and executables
debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# wasm-pack
bin/
pkg/
wasm-pack.log

# RustRover / JetBrains
#.idea/

# keep committed cargo config, ignore locally installed binaries.
# `/*` rather than `/` on purpose: git does not descend into an excluded directory, so a `!` rule
# can never re-include a file beneath one. Excluding the *contents* leaves the directory itself
# visible, which is what lets the two negations below take effect.
/.cargo/*
!/.cargo/config.toml
!/.cargo/audit.toml

# nix generated files
result
/.direnv
/.pre-commit-config.yaml

*.log

# nested test workspace build artifacts
/tests/integration/target
